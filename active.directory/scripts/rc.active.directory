#!/bin/bash
# Usage:
# apply|backend|range|cache_time|idmap_cache|idmap_neg_cache.
#

validate_range()
{
	# Validates a "low-high" range string (enhancement #2 - see
	# AI_REFACTOR_BRIEF.md section 5). Returns 0 if the format is correct
	# and low < high, 1 otherwise. This is the authoritative check - the
	# page's JS validation is a convenience only, since a request could
	# always be POSTed directly to update.php bypassing the browser.
	local range="$1"
	if [[ ! "$range" =~ ^([0-9]+)-([0-9]+)$ ]]; then
		return 1
	fi
	local low="${BASH_REMATCH[1]}"
	local high="${BASH_REMATCH[2]}"
	if [ "$low" -ge "$high" ]; then
		return 1
	fi
	return 0
}

ranges_overlap()
{
	# $1 and $2 are "low-high" strings already confirmed valid by
	# validate_range. Returns 0 (true) if they overlap, 1 (false) if not.
	local low1 high1 low2 high2
	IFS='-' read -r low1 high1 <<< "$1"
	IFS='-' read -r low2 high2 <<< "$2"
	if [ "$low1" -le "$high2" ] && [ "$low2" -le "$high1" ]; then
		return 0
	fi
	return 1
}

apply_settings()
{
	# Validate the Domain Backend Range and Backend Range before writing
	# anything. Uses the same echo-to-stdout pattern as the PID-file
	# check below (see AI_REFACTOR_BRIEF.md section 4, bug #4) so an
	# invalid range shows up in the webGUI's progress frame instead of
	# failing silently.
	if ! validate_range "$IDMAP_DOMAIN_RANGE"; then
		logger "Error: invalid IDMAP_DOMAIN_RANGE '$IDMAP_DOMAIN_RANGE'." -t$PROG_NAME
		echo "Error: Domain Backend Range '$IDMAP_DOMAIN_RANGE' is invalid. Expected format: low-high (e.g. 100000-199999), with low less than high. Settings were not applied."
		return 1
	fi

	if ! validate_range "$IDMAP_RANGE"; then
		logger "Error: invalid IDMAP_RANGE '$IDMAP_RANGE'." -t$PROG_NAME
		echo "Error: Backend Range '$IDMAP_RANGE' is invalid. Expected format: low-high (e.g. 10000-99999), with low less than high. Settings were not applied."
		return 1
	fi

	if ranges_overlap "$IDMAP_DOMAIN_RANGE" "$IDMAP_RANGE"; then
		logger "Error: IDMAP_DOMAIN_RANGE and IDMAP_RANGE overlap." -t$PROG_NAME
		echo "Error: Domain Backend Range ($IDMAP_DOMAIN_RANGE) and Backend Range ($IDMAP_RANGE) must not overlap. Settings were not applied."
		return 1
	fi

	# TDB_BACKUP_PATH is validated authoritatively (with a safe fallback)
	# by rc.shutdown/rc.startup/rc.cleanup at actual use time, since it
	# doesn't affect live AD/Samba config the way the ranges above do.
	# This is just an early, non-blocking heads-up if the saved value
	# looks wrong - Apply still proceeds either way.
	if [ -n "$TDB_BACKUP_PATH" ] && { [[ "$TDB_BACKUP_PATH" == *".."* ]] || [[ ! "$TDB_BACKUP_PATH" =~ ^/(boot|mnt)/[A-Za-z0-9_./-]+$ ]]; }; then
		echo "Warning: TDB Backup Path '$TDB_BACKUP_PATH' does not look valid (must be under /boot/ or /mnt/). The default location will be used instead until this is corrected."
	fi

	# Helper function to append a line to the configuration file
	append_conf() {
		echo "$1" >> /etc/samba/smb-active.directory.conf
	}

	# Clear the active.directory conf file
	> /etc/samba/smb-active.directory.conf

	# Configuration settings as an array of strings
	config_entries=(
		"idmap config DOMAIN : backend = $IDMAP_DOMAIN_BACKEND"
		"idmap config DOMAIN : range = $IDMAP_DOMAIN_RANGE"
		"idmap config * : backend = $IDMAP_BACKEND"
		"idmap config * : range = $IDMAP_RANGE"
		"idmap cache time = $IDMAP_CACHE_TIME"
		"idmap negative cache time = $IDMAP_NEGATIVE_CACHE_TIME"
		"winbind cache time = $WINBIND_CACHE_TIME"
		"map acl inherit = yes"
		"store dos attributes = yes"
	)

	# Append all configuration entries
	for entry in "${config_entries[@]}"; do
		append_conf "$entry"
	done

	# Set vfs objects = acl_xattr on all shares
	$DOCROOT/plugins/active.directory/scripts/config_vfs

	# Reload samba parameters, ensuring PID file exists
	pid_file='/var/run/smbd.pid'
	if [ -f "$pid_file" ]; then
		smb_pid=$(cat "$pid_file")
		/usr/bin/smbcontrol "$smb_pid" reload-config 2>&1
		echo "Active Directory settings applied successfully."
	else
		logger "Error: smbd PID file not found." -t$PROG_NAME
		echo "Error: smbd PID file not found. Settings may not have been applied."
		return 1
	fi

	# Log application of settings
	logger "Active Directory Settings Applied" -t$PROG_NAME
}


clear_winbind_cache()
{
	# Surfaces success/failure to the GUI via stdout, matching the pattern
	# established for apply_settings() (see AI_REFACTOR_BRIEF.md, section
	# 4, bug #4). This button already warns the user it will restart Samba
	# and drop SMB connections (enhancement #4), so it should also confirm
	# whether that actually succeeded rather than completing silently
	# either way.

	# Clear net cache
	if ! /usr/bin/net cache flush; then
		logger "Error: 'net cache flush' failed." -t$PROG_NAME
		echo "Error: Failed to flush the winbind cache. Samba was not restarted."
		return 1
	fi

	# Configure shares for vfs act_xattr
	$DOCROOT/plugins/active.directory/scripts/config_vfs

	# Restart samba
	sleep 1
	/etc/rc.d/rc.samba restart &>/dev/null

	# Don't trust rc.samba's own exit code - confirmed via live testing
	# that it returns 0 even when smbd fails to start entirely (e.g. the
	# binary is missing). Verify the actual outcome directly instead by
	# checking whether smbd is really running, with a brief retry loop
	# since restart is asynchronous and smbd may take a moment to come up.
	smbd_running=false
	for _ in 1 2 3 4 5; do
		if pgrep -x smbd >/dev/null 2>&1; then
			smbd_running=true
			break
		fi
		sleep 1
	done

	if [ "$smbd_running" = true ]; then
		echo "Winbind cache cleared and Samba restarted successfully."
	else
		logger "Error: smbd is not running after cache flush and restart." -t$PROG_NAME
		echo "Error: Winbind cache was cleared, but Samba failed to restart (smbd is not running). You may need to restart Samba manually."
		return 1
	fi

	logger "Winbind cache cleared" -t$PROG_NAME
}

get_domain_backend()
{
	value=`/usr/bin/testparm -vs 2>/dev/null | tr '*' ' ' | /usr/bin/grep 'idmap config domain' | /usr/bin/grep 'backend' | /bin/awk '{print $7}'`
	echo "$value"
}

get_domain_range()
{
	value=`/usr/bin/testparm -vs 2>/dev/null | tr '*' ' ' | /usr/bin/grep 'idmap config domain' | /usr/bin/grep 'range' | /bin/awk '{print $7}'`
	echo "$value"
}

get_backend()
{
	value=`/usr/bin/testparm -vs 2>/dev/null | tr '*' ' ' | /usr/bin/grep 'idmap config *' | /usr/bin/grep 'backend' | /bin/awk '{print $6}'`
	echo "$value"
}

get_range()
{
	value=`/usr/bin/testparm -vs 2>/dev/null | tr '*' ' ' | /usr/bin/grep 'idmap config *' | /usr/bin/grep 'range' | /bin/awk '{print $6}'`
	echo "$value"
}

get_winbind_cache_time()
{
	value=`/usr/bin/testparm -vs 2>/dev/null | /usr/bin/grep 'winbind cache time' | /bin/awk '{print $5}'`
	if [ "$value" = "" ]; then
		echo "default"
	else
		case "$value" in
			15)
				echo "15 seconds"
				;;
			60)
				echo "1 minute"
				;;
			300)
				echo "5 minutes"
				;;
			3600)
				echo "1 hour"
				;;
			*)
				echo "$value seconds"
				;;
		esac
	fi
}

get_idmap_cache_time()
{
	value=$(/usr/bin/testparm -s 2>/dev/null | /usr/bin/grep 'idmap cache time' | /bin/awk '{print $5}')

	if [ "$value" = "" ]; then
		echo "default"
	else
		case "$value" in
			3600)
				echo "1 hour"
				;;
			43200)
				echo "12 hours"
				;;
			86400)
				echo "24 hours"
				;;
			*)
				echo "$value seconds"
				;;
		esac
	fi
}

get_idmap_neg_cache_time()
{
	value=`/usr/bin/testparm -sv 2>/dev/null | /usr/bin/grep 'idmap negative cache time' | /bin/awk '{print $6}'`
	if [ "$value" = "" ]; then
		echo "default"
	else
		case "$value" in
			60)
				echo "1 minute"
				;;
			300)
				echo "5 minutes"
				;;
			900)
				echo "15 minutes"
				;;
			*)
				echo "$value seconds"
				;;
		esac
	fi
}

get_join_status()
{
	# Live AD join status, replacing Unraid's own built-in indicator
	# (frequently inaccurate - see AI_REFACTOR_BRIEF.md, enhancement #3).
	# Uses the exit code of 'net ads testjoin' as the source of truth
	# rather than parsing its stdout text, since the success string
	# ("Join is OK") is stable but failure text varies by failure mode -
	# the exit code is the documented, reliable signal either way.
	#
	# Output is "STATUS|DETAIL" (pipe-delimited) so the page can style
	# the status word and show the raw diagnostic text separately,
	# rather than always dumping the raw error text inline.
	testjoin_output=`/usr/bin/net ads testjoin 2>&1`
	testjoin_status=$?

	if [ $testjoin_status -eq 0 ]; then
		echo "Joined|"
	else
		echo "Not joined|$testjoin_output"
	fi
}

DOCROOT=`/usr/bin/grep -Po '^chdir = \K.*' /etc/php-fpm.d/www.conf`
if [ -z ${DOCROOT} ];then
	DOCROOT="/usr/local/emhttp"
fi

# read our configuration.
plugin="active.directory"
CONFIG="/boot/config/plugins/${plugin}/${plugin}.cfg"
# shellcheck disable=SC1090
source $CONFIG

# Set default IDMAP_DOMAIN_RANGE if blank in settings
if [ "$IDMAP_DOMAIN_RANGE" = "" ]; then
	IDMAP_DOMAIN_RANGE="100000-199999"
fi

# Set default IDMAP_RANGE if blank in settings
if [ "$IDMAP_RANGE" = "" ]; then
	IDMAP_RANGE="10000-99999"
fi

# Set default IDMAP_CACHE_TIME if blank in settings
if [ "$IDMAP_CACHE_TIME" = "" ]; then
	IDMAP_CACHE_TIME="43200"
fi

# Set default IDMAP_NEGATIVE_CACHE_TIME if blank in settings
if [ "$IDMAP_NEGATIVE_CACHE_TIME" = "" ]; then
	IDMAP_NEGATIVE_CACHE_TIME="300"
fi

# Set default WINBIND_CACHE_TIME if blank in settings
if [ "$WINBIND_CACHE_TIME" = "" ]; then
	WINBIND_CACHE_TIME="300"
fi

PROG_NAME=${plugin}

case "$1" in
	'apply')
		apply_settings 
	;;
	'clear_cache')
		clear_winbind_cache 
	;;
	'domain_backend')
		get_domain_backend
	;;
	'domain_range')
		get_domain_range
	;;
	'backend')
		get_backend
	;;
	'range')
		get_range
	;;
	'winbind_cache')
		get_winbind_cache_time
	;;
	'idmap_cache')
		get_idmap_cache_time
	;;
	'idmap_neg_cache')
		get_idmap_neg_cache_time
	;;
	'join_status')
		get_join_status
	;;
	*)
		echo "usage $0 apply|clear_cache|domain_backend|domain_range|backend|range|winbind_cache|idmap_cache|idmap_neg_cache|join_status"
esac
