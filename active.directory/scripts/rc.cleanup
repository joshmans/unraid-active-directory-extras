#!/bin/bash
# Cleanup script for TDB backups
# Keeps the KEEP_COUNT most recent generations of EACH distinct TDB file,
# rather than the N most recent files overall (see AI_REFACTOR_BRIEF.md,
# section 4, bug #1 — a global count can silently delete the only backup
# of a less-frequently-updated database while over-retaining a busy one).
#
# Requires rc.shutdown to write timestamped backups named
# <basename>.tdb.<timestamp> rather than overwriting a single copy.

TDB_BACKUP_DIR="/boot/config/plugins/active.directory/database"
KEEP_COUNT=5

if [ ! -d "$TDB_BACKUP_DIR" ]; then
    echo "Warning: Backup directory $TDB_BACKUP_DIR does not exist."
    exit 0
fi

echo "Cleaning up old TDB backups in $TDB_BACKUP_DIR..."

# Distinct base filenames, derived by stripping the trailing timestamp
basenames=$(find "$TDB_BACKUP_DIR" -maxdepth 1 -name '*.tdb.*' -printf '%f\n' 2>/dev/null \
    | sed -E 's/\.tdb\.[0-9]+-[0-9]+$/.tdb/' \
    | sort -u)

if [ -z "$basenames" ]; then
    echo "No timestamped backups found to clean up."
    exit 0
fi

while IFS= read -r base; do
    mapfile -t generations < <(ls -1t "$TDB_BACKUP_DIR/${base}."* 2>/dev/null)
    count=${#generations[@]}

    if [ "$count" -gt "$KEEP_COUNT" ]; then
        for ((i = KEEP_COUNT; i < count; i++)); do
            echo "Removing old backup: ${generations[i]}"
            rm -f "${generations[i]}"
        done
    else
        echo "$base: $count generation(s), nothing to prune."
    fi
done <<< "$basenames"

exit 0

