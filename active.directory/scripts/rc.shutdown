#!/bin/bash
# Custom shutdown script for copying TDB databases
#
# Writes each TDB file to persistent storage with a timestamp suffix
# (<basename>.<timestamp>) instead of overwriting a single fixed copy, so
# rc.cleanup can retain N generations per distinct database rather than
# a single global "most recent 5 files" pool (see AI_REFACTOR_BRIEF.md,
# section 4, bug #1).
#
# Each file is staged under a .tmp name and atomically renamed into place
# (see AI_REFACTOR_BRIEF.md, section 4, bug #2) so a backup interrupted
# mid-write never leaves a partially-copied file at its final, trusted name.
#
# Backup destination is configurable (enhancement #6, section 5) via
# TDB_BACKUP_PATH in active.directory.cfg, defaulting to the flash drive
# for backward compatibility. Falls back to the default if unset or if the
# configured value doesn't look safe - this runs unattended at shutdown
# and must never fail hard over a bad config value.

TDB_SOURCE="/var/lib/samba"
TDB_BACKUP_PATH_DEFAULT="/boot/config/plugins/active.directory/database"
CONFIG="/boot/config/plugins/active.directory/active.directory.cfg"
TIMESTAMP=$(date +%Y%m%d-%H%M%S)

if [ -f "$CONFIG" ]; then
	# shellcheck disable=SC1090
	source "$CONFIG"
fi

if [ -z "$TDB_BACKUP_PATH" ] || [[ "$TDB_BACKUP_PATH" == *".."* ]] || [[ ! "$TDB_BACKUP_PATH" =~ ^/(boot|mnt)/[A-Za-z0-9_./-]+$ ]]; then
	if [ -n "$TDB_BACKUP_PATH" ]; then
		logger "active.directory: invalid TDB_BACKUP_PATH '$TDB_BACKUP_PATH', falling back to default." -t active.directory
	fi
	TDB_BACKUP_PATH="$TDB_BACKUP_PATH_DEFAULT"
fi

TDB_DEST="$TDB_BACKUP_PATH"

if [ ! -d "$TDB_SOURCE" ]; then
	echo "Warning: TDB source directory $TDB_SOURCE does not exist."
	exit 0
fi

mkdir -p "$TDB_DEST"

echo "Copying TDB files to persistent storage ($TDB_DEST)..."

shopt -s nullglob
tdb_files=("$TDB_SOURCE"/*.tdb)
shopt -u nullglob

if [ ${#tdb_files[@]} -eq 0 ]; then
	echo "No TDB files found in $TDB_SOURCE. Nothing to back up."
	exit 0
fi

for src in "${tdb_files[@]}"; do
	base=$(basename "$src")
	dest_final="$TDB_DEST/${base}.${TIMESTAMP}"
	dest_tmp="$TDB_DEST/.${base}.${TIMESTAMP}.tmp"

	if cp "$src" "$dest_tmp"; then
		mv -f "$dest_tmp" "$dest_final"
		echo "Backed up $base -> $dest_final"
	else
		echo "Warning: failed to copy $src, leaving previous generations untouched."
		rm -f "$dest_tmp"
	fi
done

echo "TDB files copied to $TDB_DEST."

exit 0
