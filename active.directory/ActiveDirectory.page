	function activeDirectoryExtras_openFileBrowser(el) {
		// Folder-only browse popup for TDB_BACKUP_PATH, matching the
		// established pattern used by dlandon's own unassigned.devices
		// plugin (openFileBrowserUser) rather than inventing a new
		// convention - there is no single shared wrapper function across
		// Unraid plugins, only the shared underlying jQuery fileTree
		// widget (Unraid core, /plugins/dynamix/javascript/jquery.filetree.js)
		// that each plugin's own wrapper builds on.
		var inputElement = $(el);

		if (inputElement.next().hasClass('fileTree')) {
			return;
		}

		var root = inputElement.val() || '/mnt/';
		var randomId = Math.floor((Math.random() * 100000) + 1);

		inputElement.after("<span id='fileTree" + randomId + "' class='textarea fileTree'></span>");
		var fileTreeElement = $('#fileTree' + randomId);

		fileTreeElement.fileTree(
			{
				root: root,
				top: root,
				filter: 'HIDE_FILES_FILTER',
				allowBrowsing: true
			},
			function (file) {
				// Files are hidden via filter, so this shouldn't fire in
				// practice - present for API completeness/consistency
				// with the established pattern.
				inputElement.val(file);
				fileTreeElement.slideUp('fast', function () {
					fileTreeElement.remove();
				});
				inputElement.trigger('change');
			},
			function (folder) {
				inputElement.val(folder);
				fileTreeElement.slideUp('fast', function () {
					fileTreeElement.remove();
				});
				inputElement.trigger('change');
			}
		);

		fileTreeElement.css({
			'left': inputElement.position().left,
			'top': (inputElement.position().top + inputElement.outerHeight()),
			'width': (inputElement.width())
		});

		$(document).mouseup(function (e) {
			if (! fileTreeElement.is(e.target) && fileTreeElement.has(e.target).length === 0) {
				fileTreeElement.slideUp('fast', function () {
					fileTreeElement.remove();
				});
			}
		});

		inputElement.on('keydown', function () {
			fileTreeElement.slideUp('fast', function () {
				fileTreeElement.remove();
			});
		});

		fileTreeElement.slideDown('fast');
	}

	function activeDirectoryExtras_toggleJoinDetail() {
		var detail = document.getElementById('ad_join_detail');
		var toggle = document.getElementById('ad_join_detail_toggle');
		if (detail.style.display === 'none') {
			detail.style.display = 'inline';
			toggle.textContent = toggle.getAttribute('data-hide-text');
		} else {
			detail.style.display = 'none';
			toggle.textContent = toggle.getAttribute('data-show-text');
		}
	}

	function activeDirectoryExtras_parseRange(str) {
		var m = str.match(/^(\d+)-(\d+)$/);
		if (!m) {
			return null;
		}
		var low = parseInt(m[1], 10);
		var high = parseInt(m[2], 10);
		if (low >= high) {
			return null;
		}
		return { low: low, high: high };
	}

	function activeDirectoryExtras_rangesOverlap(a, b) {
		return a.low <= b.high && b.low <= a.high;
	}

	function activeDirectoryExtras_validateRanges(button) {
		// Convenience check only - the authoritative validation happens
		// server-side in rc.active.directory's apply_settings(), since a
		// request could always be POSTed directly to update.php bypassing
		// this. See AI_REFACTOR_BRIEF.md, section 5, enhancement #2.
		var domainField = document.getElementsByName('IDMAP_DOMAIN_RANGE')[0];
		var rangeField = document.getElementsByName('IDMAP_RANGE')[0];

		var domainRange = activeDirectoryExtras_parseRange(domainField.value.trim());
		var range = activeDirectoryExtras_parseRange(rangeField.value.trim());

		if (!domainRange) {
			alert(button.getAttribute('data-err-domain-range'));
			domainField.focus();
			return false;
		}
		if (!range) {
			alert(button.getAttribute('data-err-range'));
			rangeField.focus();
			return false;
		}
		if (activeDirectoryExtras_rangesOverlap(domainRange, range)) {
			alert(button.getAttribute('data-err-overlap'));
			return false;
		}
		return true;
	}
</script>

